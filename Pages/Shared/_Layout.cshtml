<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — CargoCalc</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-page="/Index">CargoCalc</a>
        <span>Калькулятор грузоперевозок</span>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <footer>Учебный проект · ASP.NET Core · C# · SQLite</footer>
</body>
</html>
